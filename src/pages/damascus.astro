---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import FeatureCard from "../components/FeatureCard.astro";
import PitchCard from "../components/PitchCard.astro";
import PlatformBadge from "../components/PlatformBadge.astro";
import DownloadButton from "../components/DownloadButton.astro";
import BuyButton from "../components/BuyButton.astro";
import PlatformCard from "../components/PlatformCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { getReleaseSnapshot } from "../lib/releases";

const release = getReleaseSnapshot();
const publishedDate = release.published_at
  ? new Date(release.published_at).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : null;
const versionLabel = release.version
  ? publishedDate
    ? `● Available now · v${release.version} · ${publishedDate}`
    : `● Available now · v${release.version}`
  : "● Available now";

const pitch = [
  {
    heading: "Built for both screens you use.",
    body: "A polished Slint desktop GUI AND a first-class ratatui TUI — same Rust core, same logbook, identical reflow rules. Pick the surface you want.",
  },
  {
    heading: "Engineered for field reality.",
    body: "Peer-to-peer multi-station sync over flaky field wifi. Op-log + hybrid logical clock means no QSOs lost when the generator hiccups.",
  },
  {
    heading: "Modern by default.",
    body: "Dark theme that respects your eyes, papaya and green accents tuned for low-light shacks, tabular monospace for everything that compares. Designed to feel as polished as the rig it sits next to.",
  },
];

const features = [
  {
    title: "Keyboard-first QSO entry",
    body: "Single-line entry strip with callsign-lookup-as-you-type (QRZ, HamQTH, Callook), DXCC and prior-QSO flags, auto-populated grid. Fully remappable hotkeys.",
    iconKind: "keyboard" as const,
  },
  {
    title: "Multiple logbooks",
    body: "One Master Log plus unlimited contest, POTA, and custom logbooks. Non-destructive merge-to-Master with preview. Selective LoTW / QRZ / eQSL upload — no double-uploads, ever.",
    iconKind: "list" as const,
  },
  {
    title: "Contest mode",
    body: "Built-in ARRL Field Day, Winter Field Day, NAQP, state QSO parties. Exchange validation, scoring, rolling rate meter (10m / 60m), Run vs S&P, multi-op aware out of the box.",
    iconKind: "signal" as const,
  },
  {
    title: "P2P multi-station sync",
    body: "Field Day-grade. Op-log + hybrid logical clock, mesh relay between stations, no central server. Same-band / same-mode collision warnings per contest rules.",
    iconKind: "p2p" as const,
  },
  {
    title: "POTA Activator + Hunter",
    body: "Per-activation logbooks, n-fer support, auto MY_SIG_INFO, live activation stats (P2P count, progress to 10), one-click POTA-formatted ADIF export.",
    iconKind: "pota" as const,
  },
  {
    title: "Rig control & power telemetry",
    body: "Native plugins for Yaesu FTDX-10, Icom IC-7610 / IC-7300, Elecraft K4 — plus a Hamlib bridge for hundreds more rigs. Read and set frequency, mode, band, VFO, split, and live TX power where the rig reports it.",
    iconKind: "rig" as const,
  },
  {
    title: "Native LoTW signing",
    body: "Pure-Rust certificate signing. No TQSL dependency. Identical behavior on Windows, macOS, and Linux. Confirmations downloaded via the LoTW report API.",
    iconKind: "lotw" as const,
  },
  {
    title: "DX cluster + spotting",
    body: "Built-in cluster client, per-cluster filters, click-to-tune sends frequency to the active radio. Spots feed the POTA Hunter workspace and pre-warm the callsign cache.",
    iconKind: "dx" as const,
  },
  {
    title: "WSJT-X / JTDX integration",
    body: "UDP feed support. FT8 / FT4 QSOs auto-route to the active logbook with full ADIF fidelity. No copy-paste, no second logger.",
    iconKind: "waveform" as const,
  },
];

---

<BaseLayout
  title="Damascus — amateur radio logging from QSO Forge"
  description="Damascus is a fast, cross-platform amateur radio logging app for daily QSOs, contests, POTA activations, and multi-station P2P field ops."
  path="/damascus"
  ogImage="/og/damascus.png"
>
  <Hero
    eyebrow={versionLabel}
    eyebrowVariant="success"
    variant="wordmark"
    subtitle="A modern, cross-platform ham radio logging application. Free 30-day evaluation — full features, no signup. License unlocks beyond evaluation."
  >
    <Fragment slot="title">DAM<span class="text-accent">A</span>SCUS</Fragment>
    <DownloadButton slot="cta" variant="primary" />
    <BuyButton slot="cta" variant="secondary" />
  </Hero>

  <section class="mx-auto max-w-5xl px-6 py-8">
    <div class="flex flex-wrap gap-3">
      <PlatformBadge platform="windows" status="available" />
      <PlatformBadge platform="linux" status="available" />
      <PlatformBadge platform="macos" status="available" />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="mb-8 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-widest text-accent">
        The 60-second pitch
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        Why operators are switching.
      </h2>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {pitch.map((p) => <PitchCard heading={p.heading} body={p.body} />)}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="mb-8 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-widest text-accent">
        The interface
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        Same core. Two surfaces. Pick your shack.
      </h2>
      <p class="mt-3 text-text-muted">
        The Slint desktop GUI and the ratatui TUI share one Rust core and one logbook. Identical reflow, identical hotkeys, identical exports — log on whichever surface fits the operating position.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      <figure
        class="overflow-hidden rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)]"
      >
        <img
          src="/screenshots/damascus.png"
          alt="Damascus desktop GUI — POTA activation at Caesar Creek State Park (US-1940), 11 QSOs logged on 40m CW, with live DX spots, POTA Activator panel, and station leaderboard visible."
          loading="lazy"
          class="block h-auto w-full"
        />
        <figcaption
          class="border-t border-[color:var(--color-border)] bg-[color:var(--color-surface-2)] px-4 py-2 text-center font-mono text-xs uppercase tracking-widest text-text-muted"
        >
          Desktop GUI · US-1940 · 40m CW
        </figcaption>
      </figure>
      <figure
        class="overflow-hidden rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)]"
      >
        <img
          src="/screenshots/damascus-tui.png"
          alt="Damascus terminal UI — same POTA activation at US-1940, 11 QSOs on 40m CW shown in a ratatui interface with entry strip, log table, and POTA Activator panel."
          loading="lazy"
          class="block h-auto w-full"
        />
        <figcaption
          class="border-t border-[color:var(--color-border)] bg-[color:var(--color-surface-2)] px-4 py-2 text-center font-mono text-xs uppercase tracking-widest text-text-muted"
        >
          Terminal UI · US-1940 · 40m CW
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="mb-8 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-widest text-accent">
        Capability
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        What's actually in the box.
      </h2>
    </div>
    <FeatureGrid columns={3}>
      {
        features.map((feature) => (
          <FeatureCard
            title={feature.title}
            body={feature.body}
            iconKind={feature.iconKind}
          />
        ))
      }
    </FeatureGrid>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="mb-8 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-widest text-accent">
        Platforms
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        Install on whatever you actually run.
      </h2>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <PlatformCard
        platform="windows"
        bullets={[
          "Windows 10 / 11 (x64)",
          "MSI installer",
          "winget package (coming)",
        ]}
        snippetPrompt="PS>"
        snippet="winget install QSOForge.Damascus"
      />
      <PlatformCard
        platform="linux"
        bullets={[
          "Debian / Ubuntu (.deb)",
          "Fedora / RHEL (.rpm)",
          "Arch (AUR: damascus-bin)",
          "Universal AppImage",
        ]}
        snippetPrompt="$"
        snippet="sudo dpkg -i damascus_<version>_amd64.deb"
      />
      <PlatformCard
        platform="macos"
        bullets={[
          "Apple Silicon + Intel",
          "Notarized .dmg",
          "Homebrew cask (coming)",
        ]}
      />
    </div>
    <p class="mt-6 text-sm text-text-muted">
      Looking for the binary downloads? See <a href="/damascus/download" class="text-accent">/damascus/download</a> for direct links, SHA256s, and sizes.
    </p>
  </section>

  <CtaBand
    heading="Try it free for 30 days."
    body="Damascus enters Evaluation mode on first launch with the full feature set for 30 days. No signup. No email. No clicks. Open the app and start logging."
  >
    <DownloadButton variant="primary" />
    <BuyButton variant="secondary" />
  </CtaBand>
</BaseLayout>
