---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PitchCard from "../components/PitchCard.astro";
import CtaBand from "../components/CtaBand.astro";

const LIVE_URL = "https://tensile.qsoforge.com";

const pitch = [
  {
    heading: "Search by geography, not by callsign.",
    body: "Map-first directory with bounding-box and radius search. Find every repeater within reach of your grid — not just the ones whose calls you already know.",
  },
  {
    heading: "Radio-horizon coverage, per repeater.",
    body: "Every repeater detail page renders a radio-horizon estimate so you can judge whether you're realistically in the footprint before you key up.",
  },
  {
    heading: "Open data, in and out.",
    body: "Built on OpenRepeaterMap, FCC ULS enrichment, and frequency-coordinator CSVs. Open formats. Open lineage. No proprietary lock-in.",
  },
];
---

<BaseLayout
  title="Tensile — modern public repeater directory from QSO Forge"
  description="Tensile is a modern public repeater directory — fast, geo-aware, built on open data. Live now at tensile.qsoforge.com."
  path="/tensile"
  ogImage="/og/tensile.png"
>
  <Hero
    eyebrow="● Live now · tensile.qsoforge.com"
    eyebrowVariant="success"
    variant="wordmark"
    subtitle="A modern public repeater directory — fast, geo-aware, and built on open data. Searchable from any browser, anywhere."
  >
    <Fragment slot="title">
      <span class="inline-flex items-center gap-4 align-middle">
        <img
          src="/tensile-mark.svg"
          alt=""
          width="80"
          height="80"
          class="h-12 w-12 shrink-0 md:h-20 md:w-20"
        />
        <span>TENSILE</span>
      </span>
    </Fragment>
    <a
      slot="cta"
      href={LIVE_URL}
      class="inline-flex items-center justify-center gap-2 rounded-md bg-[color:var(--color-accent)] px-5 py-3 text-base font-medium text-[color:var(--color-surface-0)] no-underline transition-colors hover:bg-[color:var(--color-accent)]/90"
    >
      <span>Open Tensile</span>
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 3h6v6M11 3l-8 8" />
      </svg>
    </a>
  </Hero>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="mb-8 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-widest text-accent">
        What's live today
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        The public directory.
      </h2>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {pitch.map((p) => <PitchCard heading={p.heading} body={p.body} />)}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="mb-8 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-widest text-accent">
        Coming next
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        Tensile, from your tracker.
      </h2>
      <p class="mt-3 text-text-muted">
        An APRS gateway is going in. Message
        <code class="rounded bg-[color:var(--color-surface-2)] px-1.5 py-0.5 font-mono text-sm text-text">TENSL</code>
        from your tracker and Tensile replies with the closest repeaters
        that actually reach your position — terrain-aware coverage,
        SSID-aware ranking, packed into standard APRS message lines.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <PitchCard
        heading="Two closest reachable repeaters — straight to your tracker."
        body="From a 5W HT, send TENSL a message with an optional band/mode filter. The reply lands on your tracker as compact lines: callsign, frequency, offset, tone, distance, mode. Coverage is filtered by terrain and the rank adjusts for your SSID — an HT walking gets a different answer than a mobile."
      />
      <PitchCard
        heading="Emergency beacons reach the right owners."
        body="When an APRS-IS station triggers an EMERGENCY beacon, Tensile auto-emails the owners of every claimed repeater within 100 miles. Verified emails only, deduplicated per sender, capped per event — so the people closest to the call hear about it without flooding inboxes."
      />
    </div>
  </section>

  <CtaBand
    heading="Find a repeater within reach."
    body="The directory is live, free, and open. Search by grid, by location, or by callsign."
  >
    <a
      href={LIVE_URL}
      class="inline-flex items-center justify-center gap-2 rounded-md bg-[color:var(--color-accent)] px-5 py-3 text-base font-medium text-[color:var(--color-surface-0)] no-underline transition-colors hover:bg-[color:var(--color-accent)]/90"
    >
      <span>Open tensile.qsoforge.com</span>
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 3h6v6M11 3l-8 8" />
      </svg>
    </a>
  </CtaBand>
</BaseLayout>
