---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — QSO Forge"
  description="That page doesn't exist."
  path="/404"
>
  <main class="mx-auto flex max-w-3xl flex-col items-start gap-6 px-6 py-32">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">
      404 · QSY
    </p>
    <h1 class="text-5xl font-semibold tracking-tight md:text-6xl">
      Nothing here on this frequency.
    </h1>
    <p class="max-w-xl text-lg text-text-muted">
      The page you're looking for isn't on the band. Try the home page or the
      Damascus product page.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md bg-[color:var(--color-accent)] px-5 py-3 text-base font-medium text-[color:var(--color-surface-0)] no-underline transition-colors hover:bg-[color:var(--color-accent)]/90"
        >Home</a
      >
      <a
        href="/damascus"
        class="inline-flex items-center justify-center rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] px-5 py-3 text-base font-medium text-text no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
        >Damascus</a
      >
    </div>
  </main>
</BaseLayout>
