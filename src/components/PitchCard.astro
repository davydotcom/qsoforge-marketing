---
interface Props {
  heading: string;
  body: string;
}

const { heading, body } = Astro.props;
---

<div
  class="flex flex-col gap-3 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] p-6"
>
  <h3 class="text-lg font-semibold tracking-tight text-text">{heading}</h3>
  <p class="text-text-muted leading-relaxed">{body}</p>
</div>
