---
interface Props {
  variant?: "primary" | "secondary" | "compact";
  href?: string;
  label?: string;
  showTier?: boolean;
  showArrow?: boolean;
}

const {
  variant = "primary",
  href = import.meta.env.PUBLIC_LS_DAMASCUS_CHECKOUT_URL ?? "/pricing",
  label,
  showTier = variant !== "compact",
  showArrow = variant === "secondary",
} = Astro.props;

const price = import.meta.env.PUBLIC_DAMASCUS_PRICE_USD ?? "25";
const tierLabel = "founder pricing";
const resolvedLabel =
  label ?? (variant === "compact" ? `Buy — $${price}` : `Buy license — $${price}`);

const base =
  "inline-flex items-center justify-center gap-2 font-medium rounded-md transition-colors no-underline";
const variantClass = {
  primary:
    "px-5 py-3 text-base bg-[color:var(--color-accent)] text-[color:var(--color-surface-0)] hover:bg-[color:var(--color-accent)]/90",
  secondary:
    "px-5 py-3 text-base border border-[color:var(--color-accent)] text-[color:var(--color-accent)] bg-transparent hover:bg-[color:var(--color-accent)]/10",
  compact:
    "px-3 py-1.5 text-sm bg-[color:var(--color-accent)] text-[color:var(--color-surface-0)] hover:bg-[color:var(--color-accent)]/90",
}[variant];
---

<a href={href} class={`${base} ${variantClass}`}>
  <span>{resolvedLabel}</span>
  {
    showTier && (
      <span class="text-xs font-normal opacity-80">· {tierLabel}</span>
    )
  }
  {
    showArrow && (
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 7h8M11 7l-4-4M11 7l-4 4" />
      </svg>
    )
  }
</a>
