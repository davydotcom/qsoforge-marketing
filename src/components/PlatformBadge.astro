---
interface Props {
  platform: "windows" | "linux" | "macos";
  status: "available" | "planned";
}

const { platform, status } = Astro.props;

const labels: Record<Props["platform"], string> = {
  windows: "Windows",
  linux: "Linux",
  macos: "macOS",
};

const isAvailable = status === "available";
const labelClass = isAvailable ? "text-text" : "text-text-muted";
const dotClass = isAvailable
  ? "bg-[color:var(--color-accent-alt)]"
  : "bg-[color:var(--color-border)]";
const iconClass = isAvailable ? "text-accent" : "text-text-muted";
const statusLabel = isAvailable ? "" : "planned";
---

<span
  class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] px-3 py-1.5 text-sm"
>
  <span class={`inline-block h-2 w-2 rounded-full ${dotClass}`} aria-hidden="true"></span>
  <span class={iconClass} aria-hidden="true">
    {
      platform === "windows" && (
        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
          <path d="M0 1.5l5-.7v5H0v-4.3zm5.5-.78L12 0v5.5H5.5V.72zM0 6.5h5v4.78L0 10.5V6.5zm5.5 0H12V12l-6.5-.78V6.5z" />
        </svg>
      )
    }
    {
      platform === "linux" && (
        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
          <path d="M6 0C3 0 3.5 3 3.5 3S2 4 2 6.5c0 1.5 1 2 1 3.5 0 .5-.5 1 0 1.5.5.5 6.5.5 7 0 .5-.5 0-1 0-1.5 0-1.5 1-2 1-3.5C11 4 9.5 3 9.5 3S9 0 6 0zM5 4.5c.3 0 .5.3.5.7s-.2.7-.5.7-.5-.3-.5-.7.2-.7.5-.7zm2 0c.3 0 .5.3.5.7s-.2.7-.5.7-.5-.3-.5-.7.2-.7.5-.7z" />
        </svg>
      )
    }
    {
      platform === "macos" && (
        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
          <path d="M8.4 6.4c0-1.4 1.1-2.1 1.2-2.1-.6-.9-1.6-1-2-1-.8-.1-1.7.5-2.1.5s-1.1-.5-1.8-.5c-.9 0-1.8.5-2.3 1.4-1 1.7-.3 4.2.7 5.5.5.7 1 1.4 1.8 1.4.7 0 1-.5 1.9-.5s1.1.5 1.9.5c.8 0 1.3-.7 1.8-1.4.6-.8.8-1.6.8-1.6s-1.8-.7-1.8-2.2zM7.1 2.3c.4-.5.7-1.2.6-1.9-.6 0-1.3.4-1.7.9s-.7 1.2-.6 1.8c.7.1 1.3-.3 1.7-.8z" />
        </svg>
      )
    }
  </span>
  <span class={labelClass}>{labels[platform]}</span>
  {
    statusLabel && (
      <span class="text-xs text-text-muted">· {statusLabel}</span>
    )
  }
</span>
