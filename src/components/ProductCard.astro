---
interface Props {
  name: string;
  tagline: string;
  description: string;
  status: "available" | "coming-soon";
  href: string;
  bullets?: string[];
  iconKey?: "damascus" | "tensile" | "carbon";
  ctaLabel?: string;
}

const {
  name,
  tagline,
  description,
  status,
  href,
  bullets = [],
  iconKey,
  ctaLabel,
} = Astro.props;

const isAvailable = status === "available";
const pillLabel = isAvailable ? "Available now" : "Coming soon";
const pillClass = isAvailable
  ? "border-[color:var(--color-accent-alt)]/40 bg-[color:var(--color-accent-alt)]/10 text-[color:var(--color-accent-alt)]"
  : "border-[color:var(--color-accent)]/40 bg-[color:var(--color-accent)]/10 text-[color:var(--color-accent)]";

const iconWrapClass = isAvailable
  ? "border-[color:var(--color-accent-alt)]/30 bg-[color:var(--color-accent-alt)]/10"
  : "border-[color:var(--color-accent)]/30 bg-[color:var(--color-accent)]/10";

const resolvedCta = ctaLabel ?? (isAvailable ? `View ${name}` : "Notify me");
---

<a
  href={href}
  class="group flex flex-col gap-5 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] p-6 no-underline transition-colors hover:border-[color:var(--color-accent)] hover:bg-[color:var(--color-surface-2)]"
>
  <div class="flex items-start justify-between gap-4">
    <span
      class={`grid h-10 w-10 place-items-center rounded-md border ${iconWrapClass}`}
      aria-hidden="true"
    >
      {
        iconKey === "damascus" && (
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--color-accent-alt)" stroke-width="1.8">
            <path d="M3 5h14M3 10h14M3 15h14" />
            <circle cx="6" cy="5" r="1.2" fill="var(--color-accent-alt)" />
            <circle cx="10" cy="10" r="1.2" fill="var(--color-accent-alt)" />
            <circle cx="14" cy="15" r="1.2" fill="var(--color-accent-alt)" />
          </svg>
        )
      }
      {
        iconKey === "tensile" && (
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--color-accent)" stroke-width="1.6">
            <circle cx="10" cy="10" r="3" />
            <circle cx="10" cy="10" r="6.5" />
            <path d="M10 3.5v-1M10 17.5v-1M3.5 10h-1M17.5 10h-1" />
          </svg>
        )
      }
      {
        iconKey === "carbon" && (
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--color-accent)" stroke-width="1.6">
            <path d="M2 14c2-4 4-4 4 0s2 4 4 0 2-4 4 0 2 4 4 0" />
            <path d="M2 10c2-4 4-4 4 0s2 4 4 0 2-4 4 0 2 4 4 0" opacity="0.5" />
          </svg>
        )
      }
    </span>
    <span
      class={`inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium uppercase tracking-wide ${pillClass}`}
    >
      <span class="leading-none">●</span>
      <span>{pillLabel}</span>
    </span>
  </div>

  <div>
    <p class="text-xs font-medium uppercase tracking-widest text-text-muted">
      {tagline}
    </p>
    <h3 class="mt-1 text-2xl font-semibold text-text">{name}</h3>
  </div>

  <p class="text-text-muted">{description}</p>

  {
    bullets.length > 0 && (
      <ul class="flex flex-col gap-1.5 text-sm text-text-muted">
        {bullets.map((bullet) => (
          <li class="flex items-start gap-2">
            <span class="mt-2 inline-block h-1 w-1 shrink-0 rounded-full bg-[color:var(--color-accent)]" />
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    )
  }

  <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
    {resolvedCta}
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 7h8M11 7l-4-4M11 7l-4 4" />
    </svg>
  </span>
</a>
