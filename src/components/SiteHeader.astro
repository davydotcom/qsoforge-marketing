---
import DownloadButton from "./DownloadButton.astro";

const navItems = [
  { href: "/damascus", label: "Damascus" },
  { href: "/tensile", label: "Tensile" },
  { href: "/carbon", label: "Carbon" },
  { href: "/pricing", label: "Pricing" },
  { href: "/about", label: "About" },
];
---

<header
  class="sticky top-0 z-10 border-b border-[color:var(--color-border)] bg-[color:var(--color-surface-0)]/85 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-2 text-text no-underline">
      <span
        class="grid h-8 w-8 place-items-center rounded-md bg-[color:var(--color-accent)] font-mono text-sm font-bold text-[color:var(--color-surface-0)]"
        aria-hidden="true"
      >
        QF
      </span>
      <span class="font-semibold tracking-tight uppercase">QSO Forge</span>
    </a>

    <nav class="hidden flex-1 items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-1.5 text-sm text-text-muted no-underline transition-colors hover:bg-[color:var(--color-surface-1)] hover:text-text"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <DownloadButton
        variant="compact"
        showArrow={false}
        showVersion={false}
        label="Download"
      />
      <button
        type="button"
        id="site-header-mobile-toggle"
        aria-label="Open menu"
        aria-controls="site-header-mobile-menu"
        aria-expanded="false"
        class="grid h-9 w-9 place-items-center rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] text-text md:hidden"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M2 4h12M2 8h12M2 12h12"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="site-header-mobile-menu"
    hidden
    class="border-t border-[color:var(--color-border)] bg-[color:var(--color-surface-0)] px-6 py-3 md:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-md px-3 py-2 text-base text-text no-underline hover:bg-[color:var(--color-surface-1)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById("site-header-mobile-toggle");
    const menu = document.getElementById("site-header-mobile-menu");
    if (!toggle || !menu) return;
    toggle.addEventListener("click", () => {
      const isOpen = !menu.hidden;
      menu.hidden = isOpen;
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
    });
    menu.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        menu.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open menu");
      }),
    );
  })();
</script>
