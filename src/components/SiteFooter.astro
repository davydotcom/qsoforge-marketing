---
const year = new Date().getFullYear();
---

<footer
  class="mt-24 border-t border-[color:var(--color-border)] bg-[color:var(--color-surface-1)]"
>
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-center gap-3">
      <span
        class="grid h-6 w-6 place-items-center rounded-md bg-[color:var(--color-accent)] font-mono text-[10px] font-bold text-[color:var(--color-surface-0)]"
        aria-hidden="true"
      >
        QF
      </span>
      <span>&copy; {year} QSO Forge, LLC.</span>
    </div>
    <nav class="flex flex-wrap gap-x-5 gap-y-2">
      <a href="/pricing" class="text-text-muted no-underline hover:text-text"
        >Pricing</a
      >
      <a
        href="/recover-license"
        class="text-text-muted no-underline hover:text-text">Recover license</a
      >
      <a
        href="/legal/privacy"
        class="text-text-muted no-underline hover:text-text">Privacy</a
      >
      <a
        href="/legal/terms"
        class="text-text-muted no-underline hover:text-text">Terms</a
      >
      <a
        href="https://github.com/davydotcom/qso-forge"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 text-text-muted no-underline hover:text-text"
      >
        github.com/davydotcom/qso-forge
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</footer>
