---
const year = new Date().getFullYear();
---

<footer
  class="mt-24 border-t border-[color:var(--color-border)] bg-[color:var(--color-surface-1)]"
>
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} QSO Forge, LLC. All rights reserved.</p>
    <nav class="flex flex-wrap gap-x-5 gap-y-2">
      <a href="/pricing" class="text-text-muted no-underline hover:text-text"
        >Pricing</a
      >
      <a
        href="/recover-license"
        class="text-text-muted no-underline hover:text-text">Recover license</a
      >
      <a
        href="/legal/privacy"
        class="text-text-muted no-underline hover:text-text">Privacy</a
      >
      <a
        href="/legal/terms"
        class="text-text-muted no-underline hover:text-text">Terms</a
      >
    </nav>
  </div>
</footer>
