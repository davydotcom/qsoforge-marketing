---
import FeatureIcon from "./FeatureIcon.astro";
import type { FeatureIconKind } from "../lib/icons";

interface Props {
  title: string;
  body: string;
  iconKind?: FeatureIconKind;
}

const { title, body, iconKind } = Astro.props;
---

<div
  class="flex flex-col gap-3 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] p-5"
>
  {
    iconKind && (
      <div class="grid h-8 w-8 place-items-center rounded-md border border-[color:var(--color-accent)]/30 bg-[color:var(--color-accent)]/10">
        <FeatureIcon kind={iconKind} />
      </div>
    )
  }
  <h3 class="text-base font-semibold text-text">{title}</h3>
  <p class="text-sm leading-relaxed text-text-muted">{body}</p>
</div>
