---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getReleaseSnapshot } from "../../lib/releases";
import { PLATFORM_LABELS, formatBytes, sortAssets } from "../../lib/release-types";

const release = getReleaseSnapshot();
const sortedAssets = sortAssets(release.assets);
const hasAssets = sortedAssets.length > 0;
const publishedDate = release.published_at
  ? new Date(release.published_at).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "—";
---

<BaseLayout
  title={`Download Damascus${release.version ? ` v${release.version}` : ""}`}
  description="Download Damascus binaries for Windows and Linux. Free 30-day evaluation; license unlocks the full version."
  path="/damascus/download"
  ogImage="/og/damascus.png"
>
  <section class="mx-auto max-w-4xl px-6 pt-20 pb-8">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">
      Damascus · download
    </p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">
      {hasAssets ? `Damascus v${release.version}` : "Damascus"}
    </h1>
    <p class="mt-2 text-text-muted">
      {hasAssets ? `Released ${publishedDate}.` : "First release coming soon."}
      Hosted on <code>releases.qsoforge.com</code> (Cloudflare R2). Free 30-day
      evaluation; license unlocks the full version.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-16">
    {
      !hasAssets ? (
        <div class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] p-6">
          <p class="text-text">No releases yet — check back soon.</p>
          <p class="mt-2 text-sm text-text-muted">
            Binaries land on <code>releases.qsoforge.com</code> the moment the
            first tag ships.
          </p>
        </div>
      ) : (
        <div class="overflow-hidden rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)]">
          <table class="w-full text-sm">
            <thead class="bg-[color:var(--color-surface-2)] text-left text-xs uppercase tracking-wide text-text-muted">
              <tr>
                <th class="px-4 py-3 font-medium">Platform</th>
                <th class="px-4 py-3 font-medium">Architecture</th>
                <th class="px-4 py-3 font-medium">Size</th>
                <th class="px-4 py-3 font-medium">SHA256</th>
                <th class="px-4 py-3 font-medium text-right">Download</th>
              </tr>
            </thead>
            <tbody>
              {sortedAssets.map((asset) => (
                <tr
                  data-platform={asset.platform}
                  class="border-t border-[color:var(--color-border)] [&[data-recommended='true']]:bg-[color:var(--color-surface-2)]"
                >
                  <td class="px-4 py-3 text-text">
                    {PLATFORM_LABELS[asset.platform]}
                    <span
                      class="ml-2 hidden rounded bg-[color:var(--color-accent)]/15 px-1.5 py-0.5 text-xs font-medium text-accent [tr[data-recommended='true']_&]:inline"
                    >
                      Recommended
                    </span>
                  </td>
                  <td class="px-4 py-3 text-text-muted">{asset.arch}</td>
                  <td class="px-4 py-3 text-text-muted">
                    {formatBytes(asset.size)}
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-text-muted">
                    <span title={asset.sha256}>
                      {asset.sha256.slice(0, 16)}…
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <a
                      href={asset.url}
                      download={asset.filename}
                      class="inline-flex items-center justify-center rounded-md bg-[color:var(--color-accent)] px-3 py-1.5 text-sm font-medium text-[color:var(--color-surface-0)] no-underline transition-colors hover:bg-[color:var(--color-accent)]/90"
                    >
                      Download
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }

    <p class="mt-6 text-sm text-text-muted">
      Need to verify? Each row shows the first 16 characters of the SHA256.
      Hover the hash to see the full value.
    </p>
  </section>
</BaseLayout>

<script is:inline>
  // Highlight the row matching the visitor's OS family.
  const ua = navigator.userAgent.toLowerCase();
  let family = null;
  if (ua.includes("windows")) family = "windows-msi";
  else if (ua.includes("mac")) family = "macos-dmg";
  else if (ua.includes("linux")) family = "linux-deb";

  if (family) {
    const row = document.querySelector(`tr[data-platform="${family}"]`);
    if (row) row.setAttribute("data-recommended", "true");
  }
</script>
