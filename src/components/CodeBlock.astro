---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<figure
  class="overflow-hidden rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)]"
>
  {
    label && (
      <figcaption class="border-b border-[color:var(--color-border)] bg-[color:var(--color-surface-2)] px-4 py-2 text-xs font-medium uppercase tracking-wide text-text-muted">
        {label}
      </figcaption>
    )
  }
  <pre
    class="overflow-x-auto px-4 py-4 text-sm leading-relaxed text-text"><code><slot /></code></pre>
</figure>
