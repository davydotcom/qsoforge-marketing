---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ComingSoonForm from "../components/ComingSoonForm.astro";
import MilestoneBadge from "../components/MilestoneBadge.astro";
---

<BaseLayout
  title="Carbon — browser-based SDR from QSO Forge"
  description="Carbon is a browser-based software-defined radio for QSO Forge. Tune the bands from any browser, anywhere. Coming soon."
  path="/carbon"
  ogImage="/og/carbon.png"
>
  <Hero eyebrow="● Coming soon" eyebrowVariant="accent">
    <Fragment slot="title">
      Carbon. The WebSDR, <span class="text-accent">modern edition</span>.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <p class="text-lg leading-relaxed text-text-muted">
      Tune HF from any browser, anywhere. Built on the same design language
      as Damascus, with first-class spectrum and waterfall controls that
      match how operators actually scan the bands.
    </p>

    <div class="mt-8">
      <ComingSoonForm productName="Carbon" />
    </div>

    <div class="mt-10">
      <MilestoneBadge milestone="M0" label="Receiver hardware bring-up" when="2027" />
    </div>
  </section>
</BaseLayout>
