---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ComingSoonForm from "../components/ComingSoonForm.astro";
import MilestoneBadge from "../components/MilestoneBadge.astro";
---

<BaseLayout
  title="Tensile — a modern public repeater directory from QSO Forge"
  description="Tensile is a modern repeater directory — fast, geo-aware, and built on open data. Searchable from desktop, browser, or your HT. Coming soon from QSO Forge."
  path="/tensile"
  ogImage="/og/tensile.png"
>
  <Hero eyebrow="● Coming soon" eyebrowVariant="accent">
    <Fragment slot="title">
      Tensile. The repeater directory, <span class="text-accent">rebuilt</span>.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <p class="text-lg leading-relaxed text-text-muted">
      Tensile is a modern repeater directory — fast, geo-aware, and built on
      open data. Searchable from your desktop logger, from any browser, or
      from your HT via QR. Crowdsourced and built to keep up with how the
      hobby actually changes.
    </p>

    <div class="mt-8">
      <ComingSoonForm productName="Tensile" />
    </div>

    <div class="mt-10">
      <MilestoneBadge milestone="M0" label="Field-data ingestion" when="Q4 2026" />
    </div>
  </section>
</BaseLayout>
