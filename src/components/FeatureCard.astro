---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<div
  class="flex flex-col gap-2 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] p-5"
>
  {
    Astro.slots.has("icon") && (
      <div class="text-accent">
        <slot name="icon" />
      </div>
    )
  }
  <h3 class="text-base font-semibold text-text">{title}</h3>
  <p class="text-sm leading-relaxed text-text-muted">{body}</p>
</div>
