---
interface Props {
  heading: string;
  body?: string;
}

const { heading, body } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-16">
  <div
    class="flex flex-col gap-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface-1)] p-8 md:flex-row md:items-center md:justify-between md:p-10"
    style="background: linear-gradient(90deg, rgba(255,128,0,0.06) 0%, var(--color-surface-1) 50%);"
  >
    <div class="max-w-xl">
      <h3 class="text-2xl font-semibold tracking-tight">{heading}</h3>
      {body && <p class="mt-2 text-text-muted">{body}</p>}
    </div>
    <div class="flex flex-wrap gap-3">
      <slot />
    </div>
  </div>
</section>
