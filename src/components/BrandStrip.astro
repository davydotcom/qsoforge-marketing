---
interface Props {
  label?: string;
  items?: string[];
}

const {
  label = "Built for",
  items = ["Contesting", "POTA / SOTA", "Daily logging", "Field Day", "DXCC"],
} = Astro.props;
---

<div
  class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-4 gap-y-2 px-6 pb-12 text-xs uppercase tracking-widest text-text-muted"
>
  <span class="font-semibold text-text">{label}</span>
  {
    items.map((item, idx) => (
      <>
        <span>{item}</span>
        {idx < items.length - 1 && (
          <span
            class="h-1 w-1 rounded-full bg-[color:var(--color-border)]"
            aria-hidden="true"
          />
        )}
      </>
    ))
  }
</div>
